# Sepolia RPC（Infura / Alchemy 等均可）
# 示例：https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>
SEPOLIA_RPC_URL=

# MetaMask 导出私钥（仅本地 .env 使用，勿提交、勿截图外发）
# 可带或不带 0x 前缀
SEPOLIA_PRIVATE_KEY=

# 可选：部署脚本里用于验证 setPermission 的目标地址（默认用部署者地址）
# SEPOLIA_PERMISSION_TEST_ADDRESS=0x...

# 可选：deploy:sepolia:box 部署后在脚本内自动执行一次 UUPS / Transparent 升级验证
# SEPOLIA_BOX_VERIFY_UPGRADE=1
