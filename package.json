{
  "name": "web3gitworkspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:sepolia:permission": "hardhat run scripts/deployPermissionStorageSepolia.ts --network sepolia",
    "deploy:sepolia:simple": "hardhat run scripts/deploySimpleStorageSepolia.ts --network sepolia",
    "deploy:sepolia:memo": "hardhat run scripts/deployMemoStorageSepolia.ts --network sepolia",
    "deploy:sepolia:erc20": "hardhat run scripts/deploySampleErc20Sepolia.ts --network sepolia",
    "deploy:sepolia:nft": "hardhat run scripts/deployGameItemSepolia.ts --network sepolia",
    "deploy:sepolia:box": "hardhat run scripts/deployBoxUpgradeSepolia.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
